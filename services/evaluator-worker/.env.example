# =============================================================================
# evaluator-worker — environment template
# Copy to .env.local for local development. .env.local is gitignored.
# =============================================================================

# --- Redis / BullMQ ----------------------------------------------------------
# Use REDIS_URL when targeting a managed Redis (Redis Cloud, Upstash, etc.)
# Otherwise REDIS_HOST/REDIS_PORT/etc. are honored — same precedence as
# services/cv-parser-worker and services/nextjs-web/lib/bull.ts.
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TLS=false

# --- Queue names (must match producers in nextjs-web) ------------------------
EVALUATOR_VOICE_QUEUE_NAME=voice-interview-evaluation
EVALUATOR_DESIGN_QUEUE_NAME=system-design-evaluation

# --- Supabase ----------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- LLM providers (Gemini primary, Grok fallback) ---------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

GROK_API_KEY=
# XAI_API_KEY=  # legacy alias also accepted
GROK_MODEL=grok-2-latest

# --- Evaluator behavior ------------------------------------------------------
EVALUATOR_PROVIDER=gemini
EVALUATOR_FALLBACK_PROVIDER=grok
EVALUATOR_DISABLE_FALLBACK=false
EVALUATOR_CONCURRENCY=2
EVALUATOR_TIMEOUT_MS=45000
EVALUATOR_MAX_TEXT_CHARS=24000
EVALUATOR_MODEL_VERSION=evaluator-worker@1.0.0

# Background sweeper that polls Supabase for unscored sessions / responses
# (useful before producers enqueue jobs explicitly). Set to 0 to disable.
EVALUATOR_SWEEPER_INTERVAL_MS=60000
EVALUATOR_SWEEPER_BATCH_SIZE=10

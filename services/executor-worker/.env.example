# ── Redis (BullMQ) ──────────────────────────────────────
# Provide REDIS_URL for a single connection string, OR set individual fields.
REDIS_URL=redis://127.0.0.1:6379/0
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_USERNAME=
# REDIS_PASSWORD=
# REDIS_TLS=false

# ── Supabase (admin — bypasses RLS) ────────────────────
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME

# ── Judge0 ─────────────────────────────────────────────
JUDGE0_URL=http://13.201.36.64:2358
# Optional auth token for Judge0 (omit if not required)
# JUDGE0_API_TOKEN=
# Callback URL that Judge0 will POST results to (leave empty for polling mode)
# JUDGE0_CALLBACK_URL=https://your-domain.com/api/v1/webhooks/judge0

# ── Worker tuning ──────────────────────────────────────
# EXECUTOR_CONCURRENCY=2
# EXECUTOR_POLL_INTERVAL_MS=2000
# EXECUTOR_POLL_MAX_ATTEMPTS=60
# EXECUTOR_SUBMISSION_TIMEOUT_MS=30000
